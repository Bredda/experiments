{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		// A task without `dependsOn` is only hashed from its own package, so a
		// change in a package it imports would replay a stale result. `transit`
		// is a task no package defines: it carries the changes of the workspace
		// dependencies into the hash of `test` (a Turborepo "transit node").
		"transit": {
			"dependsOn": ["^transit"]
		},
		"test": {
			"dependsOn": ["transit"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
